@model List<Comp2139Project.Models.Project>

<h2>Projects</h2>

<p>
    <a href="/Projects/Create">Create New Project</a>
</p>

<table class="table">
    <thead>
    <tr>
        <th>Title</th>
        <th>Owner</th>
        <th>Start Date</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Title</td>
            <td>@p.Owner</td>
            <td>@p.StartDate.ToShortDateString()</td>
            <td><a href="/Projects/Details/@p.Id">Details</a></td>
        </tr>
    }
    </tbody>
</table>